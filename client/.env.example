# =====================================================================
# KAMVORA STUDIO - FRONTEND ENVIRONMENT CONFIGURATION
# =====================================================================
#
# LOCAL DEVELOPMENT:
# Leave VITE_API_URL empty to let the Vite dev server proxy /api to http://localhost:5000.
#
# PRODUCTION ON NETLIFY:
# Configure this in Netlify -> Site Configuration -> Environment Variables:
# VITE_API_URL=https://kamvora-studio.onrender.com/api
#
# (Vite will bake this environment variable into the production build bundle,
# enabling direct, secure HTTPS API calls without triggering Netlify secrets scanning).

VITE_API_URL=https://kamvora-studio.onrender.com/api

# 2. Razorpay Public Merchant Key (Optional for Safe Test Mode)
# Dashboard: https://dashboard.razorpay.com/ -> Settings -> API Keys
# Key format: rzp_test_xxxxxxxx or rzp_live_xxxxxxxx
VITE_RAZORPAY_KEY_ID=
