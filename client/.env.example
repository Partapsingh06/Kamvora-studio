# =====================================================================
# KAMVORA STUDIO - FRONTEND ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# 1. API Base URL (defaults to /api if omitted, which matches Vite proxy in dev)
# For production, configure VITE_API_URL in Netlify Site Configuration -> Environment Variables.
VITE_API_URL=https://api.yourdomain.com/api

# 2. Razorpay Public Merchant Key (Optional for Safe Test Mode)
# Dashboard: https://dashboard.razorpay.com/ -> Settings -> API Keys
# Public key format: rzp_test_xxxxxxxx or rzp_live_xxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
