# =====================================================================
# KAMVORA STUDIO - FRONTEND ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. API Base URL (defaults to /api if omitted, which matches Vite proxy in dev)
# For production or cross-origin backend deployments, set the full API URL:
# VITE_API_URL=https://api.kamvorastudio.com/api
# Or:
# VITE_API_BASE_URL=/api

# 2. Razorpay Public Merchant Key (Optional for Safe Test Mode)
# Dashboard: https://dashboard.razorpay.com/ -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=
