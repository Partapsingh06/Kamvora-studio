# =====================================================================
# KAMVORA STUDIO - BACKEND ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# Server Port and Environment Mode
# Change PORT if port 5000 is occupied by another application
PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------
# 1. MONGODB ATLAS DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Connects to your MongoDB Atlas cluster when configured.
# If offline or not supplied, backend gracefully falls back to local JSON data store.
#
# IMPORTANT ATLAS INSTRUCTIONS:
# 1. Remove the angle brackets '<' and '>' around your password!
#    - INCORRECT: mongodb+srv://user:<MyPassword123>@cluster0.abcde.mongodb.net/
#    - CORRECT:   mongodb+srv://user:MyPassword123@cluster0.abcde.mongodb.net/kamvora_studio?retryWrites=true&w=majority
# 2. Specify the database name (e.g., /kamvora_studio?retryWrites=true&w=majority)
# 3. If your password contains special characters (@, :, /, ?, #, etc.), URL-encode them.
# 4. In MongoDB Atlas -> Network Access, ensure your current IP or 0.0.0.0/0 is whitelisted.
MONGODB_URI=mongodb://127.0.0.1:27017/kamvora_studio

# ---------------------------------------------------------------------
# 2. JWT AUTHENTICATION SECRET
# ---------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens for auth sessions.
JWT_SECRET=kamvora_studio_jwt_secret_2026_super_secure_key

# ---------------------------------------------------------------------
# 3. CLOUDINARY PERMANENT MEDIA STORAGE (OPTIONAL FOR LOCAL DEV)
# ---------------------------------------------------------------------
# Used for permanent cloud uploads of product images and custom order attachments.
# Obtain these from: https://console.cloudinary.com/ -> Dashboard -> Product Environment Credentials
#
# FALLBACK BEHAVIOR:
# If left empty, uploads automatically save to the local 'server/uploads/' directory.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------------------------------------------------
# 4. RAZORPAY MERCHANT PAYMENT GATEWAY (OPTIONAL FOR LOCAL DEV)
# ---------------------------------------------------------------------
# Used for accepting live UPI, Cards, Netbanking payments in India.
# Obtain these from: https://dashboard.razorpay.com/ -> Settings -> API Keys
# Key format: rzp_test_xxxxxxxxxxxx or rzp_live_xxxxxxxxxxxx
#
# FALLBACK BEHAVIOR:
# If left empty, the application runs in Safe Test Mode, generating mock payment IDs
# so you can test orders and cart checkout completely without a live merchant account.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---------------------------------------------------------------------
# 5. INITIAL ADMINISTRATOR ACCOUNT CONFIGURATION
# ---------------------------------------------------------------------
# Used to seed or initialize the initial administrator account.
ADMIN_NAME=Komal Kang (Admin)
ADMIN_EMAIL=admin@kamvorastudio.com
ADMIN_PASSWORD=KamvoraAdmin@2026
ADMIN_PHONE=+91 99150-88706

