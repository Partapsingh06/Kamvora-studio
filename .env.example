# =====================================================================
# KAMVORA STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# 2. MONGODB ATLAS DATABASE
# Connects to MongoDB Atlas when supplied; falls back to local JSON persistence if offline.
#
# IMPORTANT ATLAS INSTRUCTIONS:
# 1. Do NOT leave placeholder angle brackets '<' and '>' around your password!
#    - INCORRECT: mongodb+srv://user:<mypassword>@cluster0.abcde.mongodb.net/
#    - CORRECT:   mongodb+srv://user:mypassword@cluster0.abcde.mongodb.net/kamvora_studio?retryWrites=true&w=majority
# 2. Append the target database name: /kamvora_studio?retryWrites=true&w=majority
# 3. If password contains special symbols (@, :, /, ?, #), URL-encode them.
# 4. In MongoDB Atlas -> Network Access, allow your IP address or 0.0.0.0/0.
MONGODB_URI=mongodb://127.0.0.1:27017/kamvora_studio

# 3. JWT AUTHENTICATION
JWT_SECRET=kamvora_studio_jwt_secret_2026_super_secure_key

# 4. CLOUDINARY PERMANENT MEDIA STORAGE
# Required for uploading permanent product and reference images to Cloudinary CDN.
# When omitted, images are automatically saved locally to 'server/uploads/'.
# Dashboard: https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. RAZORPAY PAYMENT GATEWAY
# For accepting UPI, debit/credit cards, and netbanking in India.
# When omitted, frontend and backend provide a secure Test Mode fallback.
# Dashboard: https://dashboard.razorpay.com/ -> Settings -> API Keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 6. INITIAL ADMINISTRATOR ACCOUNT
ADMIN_NAME=Komal Kang (Admin)
ADMIN_EMAIL=admin@kamvorastudio.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_PHONE=+91 99150-88706

# 7. CLIENT CONFIGURATION
# Set VITE_API_URL in Netlify Site Configuration -> Environment Variables
VITE_API_URL=https://api.yourdomain.com/api
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

